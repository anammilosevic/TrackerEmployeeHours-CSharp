@model List<TrackerEmployeeHours.Models.EmployeeHoursSum>

@{
    ViewData["Title"] = "Employee Hours";
}

<h2>Employee Working Hours Summary</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
else
{

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee Name</th>
            <th>Total Time Worked (Hours)</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model)
        {
            <tr class="@(employee.TotalHours < 100 ? "table-danger" : "")">
                <td>@employee.EmployeeName</td>
                <td>@employee.TotalHours.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="mt-5">Employee Working Hours Pie Chart</h2>

<img src="@Url.Action("PieChart", "Home")"
     alt="Employee Working Hours Pie Chart"
     class="img-fluid" />

<p class="mt-3">
    <a href="@Url.Action("PieChart", "Home")"
       download="employee-working-hours.png"
       class="btn btn-primary">
        Download PNG
    </a>
</p>
}